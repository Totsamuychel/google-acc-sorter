# Credentials JSON obtained from Google Cloud Console
CREDENTIALS_FILE=credentials.json

# Name of the target Google Spreadsheet
SHEET_NAME=Учётные записи Google

# Name of the specific worksheet inside the document
WORKSHEET_NAME=Аккаунты

# Directory paths
SOURCE_DIR=source_files
ARCHIVE_DIR=archive

# Ollama model name (make sure it's pulled locally)
OLLAMA_MODEL=gpt-oss:20b
